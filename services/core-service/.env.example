CORE_SERVICE_PORT=3002

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=core-service
KAFKA_GROUP_ID=core-service-group
KAFKA_TOPIC_RAW_EVENTS=raw_events
KAFKA_TOPIC_PROCESSED_EVENTS=processed_events
KAFKA_TOPIC_REPLY_COMMANDS=reply_commands
KAFKA_TOPIC_MANUAL_REVIEW=manual_review

# Groq AI
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_COMMENTS=20

# Circuit Breaker
CB_FAILURE_THRESHOLD=10
CB_RECOVERY_TIME_MS=30000
