BACKEND_API_PORT=3000

# Facebook Graph API (ONLY this service calls Facebook)
PAGE_ACCESS_TOKEN=your_page_access_token_here
PAGE_ID=your_page_id_here
GRAPH_API_VERSION=v20.0

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=backend-api
KAFKA_GROUP_ID_REPLY=backend-api-reply-group
KAFKA_GROUP_ID_PROCESSED=backend-api-processed-group

# Theo tài liệu: reply_commands + send_retry → consume | send_failed → publish
KAFKA_TOPIC_REPLY_COMMANDS=reply_commands
KAFKA_TOPIC_PROCESSED_EVENTS=processed_events
KAFKA_TOPIC_MANUAL_REVIEW=manual_review
KAFKA_TOPIC_SEND_FAILED=send_failed
KAFKA_TOPIC_SEND_RETRY=send_retry
KAFKA_TOPIC_DEAD_LETTER=dead_letter

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fb_api_db
POSTGRES_USER=fb_api_user
POSTGRES_PASSWORD=fb_api_password

# Circuit Breaker (cho FB API calls)
CB_FAILURE_THRESHOLD=10
CB_RECOVERY_TIME_MS=30000
