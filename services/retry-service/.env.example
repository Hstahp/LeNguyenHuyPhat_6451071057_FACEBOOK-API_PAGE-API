RETRY_SERVICE_PORT=3003

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=retry-service
KAFKA_GROUP_ID=retry-service-group

# Theo tài liệu: consume send_failed → publish send_retry hoặc dead_letter
KAFKA_TOPIC_SEND_FAILED=send_failed
KAFKA_TOPIC_SEND_RETRY=send_retry
KAFKA_TOPIC_DEAD_LETTER=dead_letter

# Retry config (exponential backoff)
MAX_RETRIES=5
INITIAL_BACKOFF_MS=1000
